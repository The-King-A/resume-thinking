MYSQL_URL=jdbc:mysql://127.0.0.1:3306/resume_thinking
MYSQL_USERNAME=replace-with-authorized-user
MYSQL_PASSWORD=replace-with-authorized-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SIGNING_KEY_BASE64=replace-with-32-byte-base64-key
APP_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
# Enables direct password reset only with the Spring local profile and a loopback caller.
APP_LOCAL_PASSWORD_RESET_ENABLED=false
PYTHON_ANALYSIS_BASE_URL=http://127.0.0.1:8000
# DeepSeek/reasoning models may need several minutes to return a structured report.
PYTHON_MODEL_READ_TIMEOUT=900
# Allow long structured reports to finish without a truncated JSON response.
# Lower this value when the selected provider/model has a smaller output limit.
PYTHON_MODEL_MAX_TOKENS=100000
# auto keeps DeepSeek Flash in non-thinking mode, uses high-effort thinking for
# DeepSeek v4 Pro, disables most Qwen mixed-model thinking for stable JSON, and
# uses Qwen3.8-Flash's official thinking stream for structured output;
# use enabled or disabled to override the provider strategy explicitly.
PYTHON_MODEL_THINKING=auto
# Allow reasoning-model callbacks to finish before Java marks the task stale.
APP_MATCH_TASK_PROCESSING_LEASE=PT15M
APP_INTERVIEW_SESSION_PROCESSING_LEASE=PT15M
# Shared secret for Java -> Python internal HTTP calls. Use at least 32 printable
# ASCII characters, generate it locally, and do not commit the real value.
PYTHON_INTERNAL_SERVICE_TOKEN=replace-with-shared-service-token
JAVA_CALLBACK_BASE_URL=http://127.0.0.1:8080
# Java callback endpoint used by the worker (defaults to this local path).
MATCHING_CALLBACK_URL=http://127.0.0.1:8080/internal/v2/analysis-results
# Set true only for a local loopback fake provider; keep false for normal use.
APP_ALLOW_LOCAL_MODEL_ENDPOINTS=false
# Optional comma-separated callback base URLs in addition to loopback and JAVA_CALLBACK_BASE_URL.
PYTHON_CALLBACK_ALLOWED_BASE_URLS=
# Comma-separated Vue origins allowed to call the API during local development.
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local demo seed is disabled by default. Choose passwords locally; do not commit them.
APP_DEMO_SEED_ENABLED=false
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Only for a manually-created V1-V6 schema on its first Java start; never hand-create Flyway history.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=
SPRING_FLYWAY_BASELINE_VERSION=
