{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-thinking.local/contracts/internal/v4/interview-job.schema.json",
  "title": "InternalInterviewJob",
  "description": "Java-owned, short-lived, redacted interview work sent to the Python worker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "workType", "sessionId", "revisionId", "matchTaskId", "sessionVersion", "attempt", "callbackId", "callbackUrl", "callbackToken", "redactionRequired", "provider", "correlationId"],
  "properties": {
    "contractVersion": { "const": "4.0" },
    "workType": { "type": "string", "enum": ["QUESTION_GENERATION", "ANSWER_ANALYSIS"] },
    "sessionId": { "type": "string", "pattern": "^session[0-9]{3,}$" },
    "revisionId": { "type": "string", "pattern": "^revision[0-9]{3,}$" },
    "matchTaskId": { "type": "string", "pattern": "^task[0-9]{3,}$" },
    "sessionVersion": { "type": "integer", "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 1 },
    "callbackId": { "type": "string", "pattern": "^callback[0-9]{3,}$" },
    "callbackUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
    "callbackToken": { "type": "string", "minLength": 32, "maxLength": 1024 },
    "redactionRequired": { "const": true },
    "provider": { "$ref": "#/$defs/Provider" },
    "correlationId": { "type": "string", "format": "uuid" },
    "questionGeneration": { "$ref": "#/$defs/QuestionGeneration" },
    "answerAnalysis": { "$ref": "#/$defs/AnswerAnalysis" }
  },
  "allOf": [
    {
      "if": { "properties": { "workType": { "const": "QUESTION_GENERATION" } } },
      "then": { "required": ["questionGeneration"], "not": { "required": ["answerAnalysis"] } }
    },
    {
      "if": { "properties": { "workType": { "const": "ANSWER_ANALYSIS" } } },
      "then": { "required": ["answerAnalysis"], "not": { "required": ["questionGeneration"] } }
    }
  ],
  "not": {
    "anyOf": [
      { "required": ["ownerId"] },
      { "required": ["userId"] },
      { "required": ["databaseCredentials"] },
      { "required": ["hostFilesystemPath"] },
      { "required": ["jwt"] },
      { "required": ["plaintextPassword"] },
      { "required": ["persistenceCommand"] }
    ]
  },
  "$defs": {
    "Provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "model", "apiKey"],
      "properties": {
        "baseUrl": {
          "oneOf": [
            { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
            { "type": "string", "format": "uri", "pattern": "^http://127\\.0\\.0\\.1(?::[0-9]{1,5})?(?:/.*)?$", "maxLength": 2048 }
          ]
        },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "apiKey": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "EvidenceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceLocation", "sourceStart", "sourceEnd", "excerpt", "strength"],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^evidence[0-9]{3,}$" },
        "sourceLocation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceStart": { "type": "integer", "minimum": 0 },
        "sourceEnd": { "type": "integer", "minimum": 1 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "strength": { "type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH"] }
      }
    },
    "RequirementContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "requirementText", "requirementType", "matchStatus", "gap", "evidence"],
      "properties": {
        "requirementId": { "type": "string", "pattern": "^requirement[0-9]{3,}$" },
        "requirementText": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "requirementType": { "type": "string", "enum": ["MANDATORY", "PREFERRED"] },
        "matchStatus": { "type": "string", "enum": ["SATISFIED", "PARTIALLY_SATISFIED", "RELATED_BUT_EVIDENCE_INSUFFICIENT", "UNMET"] },
        "gap": { "type": ["string", "null"], "maxLength": 2000 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceContext" } }
      }
    },
    "QuestionGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "questionTypes", "maxQuestions"],
      "properties": {
        "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/RequirementContext" } },
        "questionTypes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["BASIC_CONFIRMATION", "PROJECT_DEEP_DIVE", "JOB_SCENARIO", "SYNTHESIS_FOLLOW_UP"] }
        },
        "maxQuestions": { "const": 4 }
      }
    },
    "QuestionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "questionType", "questionText", "requirementId", "requirementText", "evidenceIds"],
      "properties": {
        "questionId": { "type": "string", "pattern": "^question[0-9]{3,}$" },
        "questionType": { "type": "string", "enum": ["BASIC_CONFIRMATION", "PROJECT_DEEP_DIVE", "JOB_SCENARIO", "SYNTHESIS_FOLLOW_UP"] },
        "questionText": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "requirementId": { "type": "string", "pattern": "^requirement[0-9]{3,}$" },
        "requirementText": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^evidence[0-9]{3,}$" } }
      }
    },
    "AnswerAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerId", "answerText", "question", "requirement", "evidence"],
      "properties": {
        "answerId": { "type": "string", "pattern": "^answer[0-9]{3,}$" },
        "answerText": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "question": { "$ref": "#/$defs/QuestionContext" },
        "requirement": { "$ref": "#/$defs/RequirementContext" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceContext" } }
      }
    }
  }
}
